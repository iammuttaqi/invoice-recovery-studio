# Database connection URL (defaults to local sqlite; /tmp/invoicerecovery.db is used in serverless)
DATABASE_URL="file:./dev.db"

# Application URL
APP_URL="http://localhost:3000"

# Stripe Monetization (Leave blank for zero-friction Sandbox mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_LIFETIME_PRICE_ID=""
